    "doctor": "bun scripts/doctor.ts",
    "finished": "bun world/finished/run.ts"
  },
  "dependencies": {
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
